{
  "name": "nguyendinhthinhstudio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:backend": "turbo run start:dev --filter=backend",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "verify:image-upload-workflow": "node scripts/verify-image-upload-workflow.mjs",
    "verify:image-upload-final-ingress": "node scripts/verify-image-upload-final-ingress-gates.mjs",
    "postinstall": "prisma generate --schema=apps/backend/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "turbo": "^2.9.14",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@prisma/client": "^6.19.3",
    "next": "^16.2.6",
    "photoswipe": "^5.4.4",
    "react-masonry-css": "^1.0.16",
    "sonner": "^2.0.7"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.14"
    },
    "next": {
      "postcss": "8.5.15"
    }
  }
}
