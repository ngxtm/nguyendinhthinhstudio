    "framer-motion": "^12.23.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.536.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ndt/types": "^0.1.0",
    "@playwright/test": "^1.52.0",
