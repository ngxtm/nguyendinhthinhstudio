{
  "name": "backend",
  "version": "0.0.1",
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "npx nest build",
    "postbuild": "tsc -p tsconfig.build.json",
    "migrate:deploy": "prisma migrate deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:image-upload:unit": "jest --runInBand --runTestsByPath src/images/image-upload-cutover.service.spec.ts src/scripts/image-upload-cutover.spec.ts src/images/canonical-etag.spec.ts src/images/docker-runtime-contract.spec.ts src/images/image-deletion.service.spec.ts src/images/image-inspection-semaphore.service.spec.ts src/images/image-presenter.service.spec.ts src/images/image-upload-deadline.spec.ts src/images/image-upload-fingerprint.spec.ts src/images/image-upload-policy.service.spec.ts src/images/image-upload-presign-expiry.spec.ts src/images/image-upload-promotion-recovery.service.spec.ts src/images/image-upload-promotion.repository.spec.ts src/images/image-upload-rate-limit-cleanup.service.spec.ts src/images/image-upload-rate-limit.service.spec.ts src/images/image-upload-reconciler.service.spec.ts src/images/image-upload-runtime-config.spec.ts src/images/image-url.service.spec.ts src/images/images-deletion.spec.ts src/images/images.controller.spec.ts src/images/images.service.spec.ts src/images/migrations/cloudflare-r2-migration-pipeline.spec.ts src/images/migrations/cloudflare-r2-migration-runner.spec.ts src/images/migrations/cloudflare-r2-migration-script.spec.ts src/images/migrations/cloudflare-r2-migration.spec.ts src/images/migrations/cloudflare-static-assets.spec.ts src/images/pending-upload-expiry.service.spec.ts src/images/public-read-contract.spec.ts src/images/staging-resource-contract.spec.ts src/images/storage.service.spec.ts src/images/stored-image-inspector.service.spec.ts src/images/upload-cleanup.service.spec.ts src/prisma/serializable-retry.spec.ts src/scripts/reconcile-image-uploads.spec.ts src/scripts/resolve-image-upload-promotion-conflict.spec.ts",
    "test:image-upload:integration": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/image-concurrency.integration-spec.ts test/image-upload-rate-limit.integration-spec.ts test/image-upload-schema.integration-spec.ts test/image-upload-settlement.integration-spec.ts test/run-image-upload-staging.integration-spec.ts && jest --config ./test/jest-e2e.json --runInBand --runTestsByPath test/images.e2e-spec.ts",
    "test:image-upload:ci": "npm run test:image-upload:unit && npm run test:image-upload:integration",
    "test:staging:preflight": "tsx test/staging-resource-contract.ts --sanitized-fixture",
    "test:staging:preflight:live": "tsx test/staging-resource-contract.ts --live",
    "test:staging:run": "tsx test/run-image-upload-staging.ts run",
    "test:staging:cleanup": "tsx test/run-image-upload-staging.ts cleanup",
    "images:uploads:reconcile": "node /app/dist/scripts/reconcile-image-uploads.js",
  "images:uploads:resolve-conflict": "node /app/dist/scripts/resolve-image-upload-promotion-conflict.js",
  "images:uploads:cutover": "node /app/dist/scripts/image-upload-cutover.js",
    "images:deletions:process": "tsx scripts/process-image-deletions.ts",
    "images:uploads:cleanup": "tsx scripts/cleanup-expired-image-uploads.ts",
    "images:migrate:dry-run": "tsx scripts/migrate-cloudflare-images-to-r2.ts --dry-run",
    "images:migrate": "tsx scripts/migrate-cloudflare-images-to-r2.ts --execute"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@ndt/image-upload-policy": "^0.1.0",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.75.0",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "form-data": "^4.0.4",
    "jose": "^6.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@ndt/types": "^0.1.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
