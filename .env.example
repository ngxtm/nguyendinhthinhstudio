# ===========================================
# NDT Studio - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Cloudflare R2
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name

# R2 + Imgproxy
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-access-key
R2_S3_ENDPOINT=https://your-r2-endpoint
IMGPROXY_KEY=your-imgproxy-key
IMGPROXY_SALT=your-imgproxy-salt
IMGPROXY_BASE_URL=your-imgproxy-base-url

# Frontend Public Variables
NEXT_PUBLIC_API_URL=https://api.ndtstudio.site

# Backend Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://ndtstudio.site,https://www.ndtstudio.site

# Development Only
USE_MOCK_UPLOAD=false
