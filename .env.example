# ===========================================
# NDT Studio - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Cloudflare Images
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_IMAGES_TOKEN=your-images-token
CLOUDFLARE_IMAGES_HASH=your-images-hash
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name

# Frontend Public Variables
NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=your-images-hash
NEXT_PUBLIC_API_URL=https://api.ndtstudio.site

# Backend Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://ndtstudio.site,https://www.ndtstudio.site

# Development Only
USE_MOCK_UPLOAD=false
